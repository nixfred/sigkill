[gd_resource type="Resource" script_class="WeaponKit" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/unlocks/weapon_kit.gd" id="1_kit"]
[ext_resource type="Script" path="res://scripts/unlocks/weapon_skin.gd" id="2_skin"]
[ext_resource type="Script" path="res://scripts/unlocks/weapon_mod.gd" id="3_mod"]

[sub_resource type="Resource" id="Skin_cobalt"]
script = ExtResource("2_skin")
skin = "cobalt"
display_name = "stock cobalt"
fiction = "every match in cobalt"
feat = ""
need = 0

[sub_resource type="Resource" id="Skin_color_always"]
script = ExtResource("2_skin")
skin = "color_always"
display_name = "--color=always"
fiction = "every match lit green"
feat = "kills_grep_seeker"
need = 15

[sub_resource type="Resource" id="Skin_regex"]
script = ExtResource("2_skin")
skin = "regex"
display_name = "regex"
fiction = "^(.*)$: it matches everything"
feat = "kills_grep_seeker"
need = 40

[sub_resource type="Resource" id="Mod_max_count"]
script = ExtResource("3_mod")
id = "max_count"
display_name = "grep -m 4"
fiction = "more marks, a slower lock"
gains = {"max_marks": 4}
costs = {"lock_s": 0.8}
feat = "grep_marks"
need = 15

[resource]
script = ExtResource("1_kit")
weapon = "grep_seeker"
skins = Array[Resource]([SubResource("Skin_cobalt"), SubResource("Skin_color_always"), SubResource("Skin_regex")])
mod = SubResource("Mod_max_count")
