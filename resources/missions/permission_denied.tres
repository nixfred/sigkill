"radius": 2.5,
"text": "Get into the records sector"
}, {
"id": "hold",
"kind": "survive",
"seconds": 60.0,
"text": "Hold out while the records load"
}, {
"id": "owner",
"kind": "log",
"log": "owner",
"text": "Read the daemons' owner record"
}]
logs = [{
