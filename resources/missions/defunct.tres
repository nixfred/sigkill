[gd_resource type="Resource" script_class="MissionDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/missions/mission_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = "defunct"
order = 2
title = "defunct"
register = "cyberpunk"
goal = "Find where the zombies come from and kill their parent, so init can adopt and reap them all."
loadout = PackedStringArray("terminal_cannon", "sigterm", "sigkill_rail")
grants = PackedStringArray("ping_sonar", "fork_bomb", "fork_shotgun")
abilities = PackedStringArray()
objectives = [{
"arms": ["ping_sonar"],
"count": 6,
"daemon": "zombie",
"hint": "9 ping: everything it reaches answers",
"id": "rain",
"kind": "kill",
"of": ["rain_a", "rain_b", "rain_c"],
"text": "Find them in the rain"
}, {
"at": "plaza",
"hint": "the marker points where they queued",
"id": "trail",
"kind": "reach",
"label": "where they queued",
"radius": 5.5,
"text": "Follow them to where they queued"
}, {
"arms": ["fork_bomb", "fork_shotgun"],
"count": 10,
"daemon": "zombie",
"hint": "4 fork bomb: crowds  5 fork(): up close",
"id": "queue",
"kind": "kill",
"of": ["queue"],
"text": "Clear the queue at the dead storefront"
}, {
"hint": "walk through a terminal to read it",
"id": "shop",
"kind": "log",
"log": "storefront",
"text": "Read the storefront's log"
}, {
"at": "daemon_3",
"hint": "ping lights their threads",
"id": "threads",
"kind": "reach",
"label": "their parent",
"radius": 6.0,
"text": "Follow their threads to their parent"
}, {
"count": 1,
"daemon": "rogue",
"hint": "it's guarding something sealed",
"id": "guard",
"kind": "kill",
"of": ["guard"],
"text": "Kill the parent's guard"
}, {
"count": 1,
"daemon": "parent",
"hint": "the core shows when it opens",
"id": "parent",
"kind": "kill",
"of": ["nest"],
"text": "Kill their parent"
}]
logs = [{
"at": "shop",
"id": "storefront",
"name": "storefront.log",
"text": "the shop closed six years ago.\nthe lights are on a timer nobody owns."
}, {
"at": "log_2",
"id": "kiosk",
"name": "kiosk.log",
"text": "HELLO AGAIN, CUSTOMER.\nyour session expired 2190 days ago.\nplease wait to be served.\nplease wait to be served."
}, {
"at": "log_3",
"id": "jobs",
"name": "jobs.txt",
"text": "STAT  PPID  COMMAND\nZ     4087  [sync] <defunct>\nZ     4087  [thumbs] <defunct>\nZ     4087  [backup] <defunct>\nparent 4087: sleeping. SIGCHLD ignored. never waits."
}]
lines = [{
"on": "start",
"text": "audit: user=? action=enter path=/dev/pts result=DENIED reason=\"no session\"",
"who": "auditor"
}, {
"on": "begin:rain",
"text": "Those shapes in the rain aren't cover. Ping them. Everything it reaches answers, even the dead.",
"who": "ai"
}, {
"on": "woke:rain_a",
"text": "Zombies. Dead, never reaped. Nobody told them.",
"who": "ai"
}, {
"on": "done:rain",
"text": "See the threads? Every one of them runs somewhere. And they all run the same way.",
"who": "ai"
}, {
"on": "begin:trail",
"text": "audit: user=? action=follow path=/dev/pts/4 result=DENIED reason=\"no session\"",
"who": "auditor"
}, {
"on": "woke:queue",
"text": "That's a queue. Jobs waiting at a door that closed. Crowd: throw something that multiplies.",
"who": "ai"
}, {
"on": "done:queue",
"text": "They were in line for a terminal that never opened again.",
"who": "ai"
}, {
"on": "begin:shop",
"text": "audit: user=? action=read path=/dev/pts/4 result=DENIED reason=\"no session\"",
"who": "auditor"
}, {
"on": "log:storefront",
"text": "These were jobs from a terminal you closed. You said you'd check on them tomorrow.",
"who": "ai"
}, {
"on": "log:kiosk",
"text": "Six years of greeting nobody. Still polite about it.",
"who": "ai"
}, {
"on": "log:jobs",
"text": "Every one of them, the same parent. And it's not even dead. It just never asks.",
"who": "ai"
}, {
"on": "begin:threads",
"text": "Their threads all run down the street. Something down there started them and never came back.",
"who": "ai"
}, {
"on": "woke:strays",
"text": "More of them. Same threads.",
"who": "ai"
}, {
"on": "begin:guard",
"text": "audit: pid 4087 state=S children=Z. SIGCHLD ignored.",
"who": "auditor"
}, {
"on": "woke:guard",
"text": "That one's no zombie. Highest priority, standing guard over something big.",
"who": "ai"
}, {
"on": "wave:fork_a",
"text": "It's forking. More children. It doesn't even wait for them.",
"who": "ai"
}, {
"on": "done:guard",
"text": "Its guard's down. It's opening. Hit the core.",
"who": "ai"
}, {
"on": "done:parent",
"text": "audit: pid 4087 exited. its children re-parented to init (pid 1). reaped.",
"who": "auditor"
}, {
"on": "complete",
"text": "It's you. Not 'like you'. You.",
"who": "ai"
}, {
"on": "fail",
"text": "Up. They waited six years. They can wait one more try.",
"who": "ai"
}]
