[gd_resource type="Resource" script_class="MissionDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/missions/mission_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = "nohup"
order = 6
title = "nohup"
register = "cyberpunk"
goal = "Go down to the oldest directory in the machine and find the shell that never hung up."
loadout = PackedStringArray("terminal_cannon", "sigterm", "sigkill_rail", "ping_sonar", "fork_bomb", "fork_shotgun", "grep_seeker", "pipe_chain", "chmod_000", "cron_mines", "rm_rf_cannon")
grants = PackedStringArray("sighup", "dev_null")
abilities = PackedStringArray("sigstop")
objectives = [{
"at": "foot_0",
"hint": "down the ramp of racks. Jump the lip to drop",
"id": "down",
"kind": "reach",
"label": "the first landing",
"radius": 2.5,
"text": "Go down: the first landing"
}, {
"arms": ["sighup"],
"count": 3,
"hint": "Shift+4 SIGHUP: they reload and forget you",
"id": "hangup",
"kind": "hup",
"of": ["watch_1", "watch_2"],
"text": "Hang up on the watchers"
}, {
"count": 3,
"daemon": "any",
"hint": "confused, they lash at whatever is nearest",
"id": "clear",
"kind": "kill",
"of": ["watch_1", "watch_2"],
"text": "Clear the landing"
}, {
"arms": ["dev_null"],
"count": 5,
"daemon": "any",
"hint": "Shift+3 /dev/null: throw it into the crowd",
"id": "sink",
"kind": "kill",
"of": ["queue_1", "queue_2"],
"text": "Send the crowd at the stair to /dev/null"
}, {
"at": "shell",
"hint": "F SIGSTOP: stop the world. Don't touch it",
"id": "dark",
"kind": "reach",
"label": "the oldest directory",
"radius": 3.0,
"text": "Reach the oldest directory in the dark",
"unlocks": ["sigstop"]
}, {
"hint": "it is typing. to you",
"id": "listen",
"kind": "survive",
"seconds": 9.0,
"text": "Let the shell finish"
}, {
"hint": "Shift+4 SIGHUP: throw it at the screen",
"id": "hup",
"kind": "hup",
"prop": "shell",
"text": "Hang up the shell"
}, {
"at": "below",
"hint": "the floor is going",
"id": "fall",
"kind": "reach",
"label": "the core",
"radius": 7.0,
"text": "Fall"
}]
logs = [{
"at": "log_0",
"id": "mount",
"name": "mount.log",
"text": "mount /oldest\n# flooded. nothing here has been opened in years.\n# the lights are on. nobody is home."
}, {
"at": "log_1",
"id": "todo",
"name": "TODO.old",
"text": "# TODO: finish this\n# TODO: come back for the rest\n# TODO: log out\n(none of them done)"
}, {
"at": "log_2",
"id": "last",
"name": "last.log",
"text": "LAST LOGIN: years ago\nSESSION: still open\nTERMINAL: gone\n# a shell with no terminal keeps running."
}, {
"at": "log_3",
"id": "zero",
"name": "project_zero/README",
"text": "# project zero\n# the first one. the one that started it all.\n# status: running"
}]
lines = [{
"on": "start",
"text": "audit: user=? action=enter path=/oldest result=DENIED reason=\"escalation approved\"",
"who": "auditor"
}, {
"on": "start",
"text": "The bottom of the tree. Your oldest projects, drowned. Whatever never logged out is down there.",
"who": "ai"
}, {
"on": "begin:down",
"text": "Everything's awake down here. All three kinds. The way down is a ramp of racks: find it, and keep moving.",
"wait": 3.0,
"who": "ai"
}, {
"on": "begin:hangup",
"text": "audit: depth=2. watchers reniced. escalation pending.",
"who": "auditor"
}, {
"on": "begin:hangup",
"text": "SIGHUP. Hang up on them: a process that loses its terminal rereads its config and forgets what it was doing.",
"wait": 1.0,
"who": "ai"
}, {
"on": "done:hangup",
"text": "They've lost the thread. Confused, they lash at whatever's nearest. Each other included.",
"who": "ai"
}, {
"on": "begin:sink",
"text": "The whole queue, at the foot of the stair. /dev/null: throw it into the middle. Everything near it goes too.",
"who": "ai"
}, {
"on": "begin:dark",
"text": "audit: escalation approved. black ICE dispatched to depth=3.",
"who": "auditor"
}, {
"on": "begin:dark",
"text": "Black ICE. Don't shoot it. Don't touch it. Get the brute ready and get *out*.",
"wait": 0.6,
"who": "ai"
}, {
"on": "begin:dark",
"text": "SIGSTOP's yours now. F stops the world, you included, almost. The lights are going. If I drop, run. Don't wait for m",
"wait": 2.6,
"who": "ai"
}, {
"on": "wave:black_1",
"text": "audit: black ICE on the floor. link severed. intruder alone at depth=3.",
"who": "auditor"
}, {
"on": "done:dark",
"text": "audit: path=/oldest owner=user. black ICE recalled: the user will handle it.",
"who": "auditor"
}, {
"on": "done:dark",
"text": "...still here? I lost you for a second. Don't do that again.",
"wait": 2.0,
"who": "ai"
}, {
"on": "begin:listen",
"text": "log out. i'll keep it all running. you never did anyway.",
"wait": 1.5,
"who": "tilde"
}, {
"on": "begin:listen",
"text": "That shell's been open for four years. It never logged out. It never *slept*.",
"wait": 6.5,
"who": "ai"
}, {
"on": "begin:hup",
"text": "It's talking to you. Hang up on it. SIGHUP: every shell dies when its terminal goes.",
"who": "ai"
}, {
"on": "done:hup",
"text": "nohup. remember?",
"wait": 1.0,
"who": "tilde"
}, {
"on": "done:hup",
"text": "...it ignores hangups. It's been ignoring them for years. Move. The floor.",
"wait": 3.2,
"who": "ai"
}, {
"on": "complete",
"text": "That heat. That's the core. That's where it lives. Next time we go in, we go in with everything.",
"wait": 1.5,
"who": "ai"
}, {
"on": "fail",
"text": "Drowned, or flatlined. Either way the shell's still running. Again.",
"who": "ai"
}]
transitions = []
