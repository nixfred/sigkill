[gd_resource type="Resource" script_class="WeaponKit" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/unlocks/weapon_kit.gd" id="1_kit"]
[ext_resource type="Script" path="res://scripts/unlocks/weapon_skin.gd" id="2_skin"]
[ext_resource type="Script" path="res://scripts/unlocks/weapon_mod.gd" id="3_mod"]

[sub_resource type="Resource" id="Skin_fork"]
script = ExtResource("2_skin")
skin = "fork"
display_name = "stock magenta"
fiction = ":(){ :|:& };: in its own magenta"
feat = ""
need = 0

[sub_resource type="Resource" id="Skin_c64"]
script = ExtResource("2_skin")
skin = "c64"
display_name = "C64"
fiction = "READY. RUN: eight bits, doubling"
feat = "kills_fork_bomb"
need = 15

[sub_resource type="Resource" id="Skin_exponential"]
script = ExtResource("2_skin")
skin = "exponential"
display_name = "exponential"
fiction = "2^n and climbing"
feat = "bomb_triples"
need = 1

[sub_resource type="Resource" id="Mod_ulimit"]
script = ExtResource("3_mod")
id = "ulimit"
display_name = "ulimit -u"
fiction = "more bombs, shallower trees"
gains = {"magazine_size": 3}
costs = {"projectile:generations": 3}
feat = "kills_fork_bomb"
need = 6

[resource]
script = ExtResource("1_kit")
weapon = "fork_bomb"
skins = Array[Resource]([SubResource("Skin_fork"), SubResource("Skin_c64"), SubResource("Skin_exponential")])
mod = SubResource("Mod_ulimit")
