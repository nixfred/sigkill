[resource]
script = ExtResource("1_kit")
weapon = "sigterm"
skins = Array[Resource]([SubResource("Skin_violet"), SubResource("Skin_ctrl_c"), SubResource("Skin_catppuccin")])
mod = SubResource("Mod_choke")
