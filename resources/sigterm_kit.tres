need = 50

[sub_resource type="Resource" id="Mod_choke"]
script = ExtResource("3_mod")
id = "choke"
display_name = "choke"
fiction = "a tighter grace period: fewer, closer pleas"
gains = {"spread_degrees": 4.0}
costs = {"pellet_count": 7}
