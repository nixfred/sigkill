; Engine configuration file.
; Hand-written without the editor (Godot was not installed when this was made).
; Opening the project in Godot 4.7 will rewrite and normalise this file; that is fine.

config_version=5

[application]

config/name="SIGKILL"
config/description="Native first-person shooter for Omarchy. Hunt rogue daemons in a terminal arena."
; The release version (pre-alpha drop, build 33 = chunk C33). Shown small in the boot screen's and the
; menu's corner and in the window title (scripts/settings/settings_apply.gd version_tag()).
config/version="0.33.0-prealpha"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
; The official icon-only nixfred hexagon with the white >_, byte for byte the brand file
; (docs/media/nixfred-icon.svg), never redrawn. The same file is the launcher icon (packaging/linux/).
config/icon="res://packaging/linux/sigkill.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="targets"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

; The daemons' shared shader clock (A2b): stepped once a frame at the game's pace by
; scripts/daemons/daemon_art.gd, read by every daemon shader.
daemon_clock={
"type": "float",
"value": 0.0
}

; The arena's shared shader clock (A4): stepped once a frame at the game's pace by
; scripts/arena/arena_art.gd, read by the arena's lights, screens and holograms.
arena_clock={
"type": "float",
"value": 0.0
}

; The arena's light level (I3): 1 normal, down to Black ICE's lights_low while it is out. Set by
; scripts/ice/blackout.gd, read by the arena's lights, panels, screens, holograms, floor, rain and skyline.
arena_light={
"type": "float",
"value": 1.0
}

; The ruins' register (C36): how much of each the ruins stand in, x tron, y cyberpunk, z matrix and w "all" (the
; finale's three at once, mixed across the place). Set by scripts/ruins/ruins_world.gd, read by the ruins' shaders.
ruins_mix={
"type": "vec4",
"value": Vector4(1, 0, 0, 0)
}

; A register shift's tear in the ruins (C36): 0 calm, up to 1 at the height of a shift. Set by scripts/ruins/ruins_world.gd.
ruins_tear={
"type": "float",
"value": 0.0
}
